# Copy to .env (local) or set these in the Vercel project settings.
#
# Folder on your own server that holds the files written by build/build.py:
#   update.json, AyniteDM-Setup-<version>.exe, AyniteDM-Setup-<version>.exe.sha256,
#   aynitedm-chrome-extension.zip, aynitedm-firefox.xpi
# The download button reads update.json there to show the current version and link the installer.
VITE_DOWNLOAD_BASE=https://aynitesoft.com/aynitedm/files/
# Where the Support link points.
VITE_SUPPORT_URL=https://aynitesoft.com
# Optional: once the add-ons are listed in the stores, the page shows store buttons instead of manual steps.
VITE_CHROME_STORE_URL=
VITE_FIREFOX_ADDON_URL=
# Where the Buy now buttons go (defaults to the support address)
VITE_BUY_URL=https://aynitesoft.com
# Where "Share your experience" goes (defaults to the support address)
VITE_FEEDBACK_URL=https://aynitesoft.com
